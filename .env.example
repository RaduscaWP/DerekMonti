# Resend API key used by api/quote.js for the advisor notification and traveler confirmation.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxx

# Optional. Override the "From" address used by api/quote.js. Use this once your
# sending domain is verified in Resend (with SPF/DKIM/DMARC). Until then the code
# falls back to Resend's shared sandbox sender, which often lands in spam.
# Format: "Display Name <noreply@your-verified-domain.com>"
# MAIL_FROM_ADDRESS=Fly with Derek <noreply@your-verified-domain.example>

# Required for automatic public intake. Cloudflare Turnstile bot/abuse protection.
# Create a site at https://dash.cloudflare.com/?to=/:account/turnstile and add
# both keys to Vercel. Missing/mismatched configuration returns temporary
# unavailability; direct contact remains available. Never silently skip verification.
# Client (must start with VITE_ so Vite exposes it):
# VITE_TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxxxxxx
# Server (keep secret, never commit):
# TURNSTILE_SECRET=0x4AAAAAAAxxxxxxxxxxxx
# TURNSTILE_EXPECTED_HOSTNAMES=www.flywithderek.com,flywithderek.com
# QUOTE_CHALLENGE_MODE=required
# Deliberate alternative: distributed_only, after reviewing abuse budgets.
# Redis admission, recipient/global budgets and registry remain mandatory.
# It does not assume unverified WAF/edge protection. Remove the client widget
# key in this mode. The default remains required.

# Required for production AND public previews: distributed quotas and receipts.
# Missing Redis or a Redis error stops automatic dispatch with 503.
# Either pair works — the code accepts both naming conventions.
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxx
# KV_REST_API_URL=https://xxxx.upstash.io
# KV_REST_API_TOKEN=xxxx
# Server-only, independently generated random secret of at least 32 characters.
# Used to bind payloads and hash IP/recipient quota keys. Never expose with VITE_.
# QUOTE_DIGEST_SECRET=replace-with-a-server-only-random-secret-at-least-32-characters
# QUOTE_ALLOWED_ORIGINS=https://www.flywithderek.com,https://flywithderek.com

# Registry retains minimal digest/reference/state for 48h. Unknown sends retry
# only within 23h, inside Resend's documented 24h idempotency window.
# See api/README-security.md for safe retries, quotas and configuration checks.

# Optional. Used by the email template to build absolute URLs.
# PUBLIC_SITE_URL=https://www.flywithderek.com

# Optional safety override. Vercel Preview/Development deployments are blocked
# automatically through VERCEL_ENV. Set this on any other staging host.
# FLY_WITH_DEREK_NOINDEX=true
